# ==============================================================================
# SurgesEntry — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env     (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# NOTE: docker-compose enforces that POSTGRES_USER and POSTGRES_PASSWORD must be
# set in .env. Startup will fail closed if these variables are missing.
# ==============================================================================

# Database Credentials & Port (Required)
POSTGRES_USER=eventplatform
POSTGRES_PASSWORD=eventplatform_dev_secret_change_me
POSTGRES_DB=eventplatform
POSTGRES_PORT=5432

# Event Streaming & Storage Endpoints (Local Defaults)
KAFKA_BROKER=localhost:9092
REDIS_ADDR=localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Traffic Simulator Defaults
# Normal interactive testing: 5 events/sec across 10 users
# Benchmark testing: set EVENT_RATE=200, NUM_USERS=50 (see BENCHMARKS.md)
EVENT_RATE=5
NUM_USERS=10
